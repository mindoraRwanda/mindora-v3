# Kong gateway base URL. Expo inlines EXPO_PUBLIC_* vars at build time.
# Leave unset to use the production default (see constants/Config.ts).
# For local dev against a backend running via `docker compose up` in Mindora_V3:
#   EXPO_PUBLIC_KONG_BASE_URL=http://localhost:8000
# On a physical device/simulator on the same network, use your machine's LAN IP
# instead of localhost, e.g. http://192.168.1.20:8000.
EXPO_PUBLIC_KONG_BASE_URL=https://api.mindora.rw
